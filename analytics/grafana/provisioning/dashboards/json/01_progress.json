                        "uid": "eduflow-clickhouse"
                    },
                    "editorType": "sql",
                    "queryType": "sql",
                    "format": 1,
                    "rawSql": "SELECT check_method, count() AS samples,\n  round(avg(avg_days), 2) AS avg_days,\n  round(avg(median_days), 2) AS median_days\nFROM eduflow.metric_avg_time_to_result\nGROUP BY check_method\nORDER BY check_method"
                }
            ]
