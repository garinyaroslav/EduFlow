                        "type": "grafana-clickhouse-datasource",
                        "uid": "eduflow-clickhouse"
                    },
                    "editorType": "sql",
                    "queryType": "sql",
                    "format": 1,
                    "rawSql": "SELECT group_name, week_start, nodes_appeared, nodes_completed,\n  round(nodes_completed / nullIf(nodes_appeared, 0), 3) AS completion_rate\nFROM eduflow.metric_completion_by_week\nORDER BY week_start DESC, nodes_appeared DESC\nLIMIT 50"
                }
            ]
