{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Сводка прогонов (benchmark_runs)",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  run_id AS \"Run ID (run_id)\",\n  preset AS \"Пресет (preset)\",\n  students AS \"Студентов (students)\",\n  total_rows AS \"Строк (total_rows)\",\n  generate_sec AS \"Generate, с (generate_sec)\",\n  load_sec AS \"Load, с (load_sec)\",\n  spark_sec AS \"Spark, с (spark_sec)\",\n  q_bottleneck_sec AS \"SQL bottleneck, с\",\n  q_completion_week_sec AS \"SQL completion_week, с\",\n  measured_at AS \"Когда (measured_at)\"\nFROM eduflow.benchmark_runs\nORDER BY total_rows, measured_at"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "title": "Pipeline: объём → время (generate / load / spark)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 9 },
      "id": 2,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  total_rows AS time,\n  elapsed_sec AS value,\n  operation AS metric\nFROM eduflow.benchmark_timings\nWHERE category = 'pipeline'\nORDER BY total_rows, operation"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 8,
            "showPoints": "always",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "SQL: объём → время (все запросы)",
      "description": "По горизонтали — число строк в наборе данных, по вертикали — время выполнения запроса. Для одного объёма показана медиана замеров по прогонам. Каждый замер уже содержит медиану повторов внутри прогона.",
      "type": "xychart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 9 },
      "id": 3,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  total_rows,\n  operation,\n  quantileExactInclusive(0.5)(elapsed_sec) AS median_sec\nFROM eduflow.benchmark_timings\nWHERE category = 'sql'\nGROUP BY total_rows, operation\nORDER BY total_rows, operation"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": { "rowField": "total_rows", "columnField": "operation", "valueField": "median_sec", "emptyValue": "null" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Время выполнения",
            "show": "points+lines",
            "lineWidth": 2,
            "pointSize": { "fixed": 7 }
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total_rows\\operation" },
            "properties": [
              { "id": "unit", "value": "locale" },
              { "id": "custom.axisLabel", "value": "Объём данных, строк" }
            ]
          }
        ]
      },
      "options": {
        "mapping": "auto",
        "series": [],
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "title": "Pipeline по пресетам (bar)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 19 },
      "id": 4,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  preset AS \"Пресет (preset)\",\n  avg(generate_sec) AS \"Generate, с (generate_sec)\",\n  avg(load_sec) AS \"Load, с (load_sec)\",\n  avg(spark_sec) AS \"Spark, с (spark_sec)\"\nFROM eduflow.benchmark_runs\nGROUP BY preset\nORDER BY min(total_rows)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 85, "gradientMode": "hue", "lineWidth": 1 },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Generate, с (generate_sec)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Load, с (load_sec)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Spark, с (spark_sec)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "none" },
        "xTickLabelRotation": 0
      }
    },
    {
      "title": "Тяжёлые SQL по пресетам (bar)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 19 },
      "id": 5,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  preset AS \"Пресет (preset)\",\n  avg(q_bottleneck_sec) AS \"bottleneck\",\n  avg(q_completion_week_sec) AS \"completion_week\",\n  avg(q_time_to_result_sec) AS \"time_to_result\",\n  avg(q_ai_correction_sec) AS \"ai_correction\",\n  avg(q_full_scan_grades_sec) AS \"full_scan\"\nFROM eduflow.benchmark_runs\nGROUP BY preset\nORDER BY min(total_rows)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.75,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi", "sort": "none" },
        "xTickLabelRotation": 0
      }
    },
    {
      "title": "Масштабирование: секунды на 1M строк (SQL)",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "id": 6,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  operation AS \"Операция (operation)\",\n  avg(elapsed_sec / (total_rows / 1000000.0)) AS \"Сек на 1M строк\"\nFROM eduflow.benchmark_timings\nWHERE category = 'sql' AND total_rows > 0\nGROUP BY operation\nORDER BY \"Сек на 1M строк\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-YlOrRd" },
          "custom": {
            "axisLabel": "с / 1M строк",
            "fillOpacity": 90,
            "gradientMode": "scheme"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.75,
        "legend": { "displayMode": "hidden", "showLegend": false },
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xTickLabelMaxLength": 28
      }
    },
    {
      "title": "Доля фаз pipeline (medium/large)",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 29 },
      "id": 7,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  operation AS \"Фаза (operation)\",\n  sum(elapsed_sec) AS \"Сумма, с (elapsed_sec)\"\nFROM eduflow.benchmark_timings\nWHERE category = 'pipeline' AND preset IN ('medium', 'large')\nGROUP BY operation\nORDER BY operation"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "generate" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "load" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "spark" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "title": "Все timings (таблица)",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 39 },
      "id": 8,
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "eduflow-clickhouse" },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT\n  preset AS \"Пресет (preset)\",\n  total_rows AS \"Строк (total_rows)\",\n  students AS \"Студентов (students)\",\n  operation AS \"Операция (operation)\",\n  category AS \"Категория (category)\",\n  elapsed_sec AS \"Время, с (elapsed_sec)\",\n  measured_at AS \"Когда (measured_at)\",\n  run_id AS \"Run ID (run_id)\"\nFROM eduflow.benchmark_timings\nORDER BY total_rows, category, operation"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ],
